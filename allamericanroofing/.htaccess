# ==============================================================================
# All American Roofing — Apache / Hostinger Clean URL & Caching Configuration
# Domain: https://allamericanroofing.homes
# ==============================================================================

Options -Indexes +FollowSymLinks
DirectoryIndex index.html
RewriteEngine On

# 1. Canonical host & HTTPS enforcement on production domain
RewriteCond %{HTTP_HOST} ^www\.allamericanroofing\.homes$ [NC]
RewriteRule ^(.*)$ https://allamericanroofing.homes/$1 [R=301,L]

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^allamericanroofing\.homes$ [NC]
RewriteRule ^(.*)$ https://allamericanroofing.homes/$1 [R=301,L]

# 2. Pass through static assets, sitemap, and robots directly
RewriteRule ^assets/ - [L]
RewriteRule ^sitemap\.xml$ - [L]
RewriteRule ^robots\.txt$ - [L]

# 3. Redirect explicit /index.html or /*/index.html requests to canonical slash URL
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L]

# 4. Redirect legacy *.html URLs (excluding /404.html) to clean trailing-slash URLs
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/404\.html$ [NC]
RewriteRule ^(.+?)\.html$ /$1/ [R=301,L]

# 5. Enforce trailing slash on existing directories for URL consistency
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ /$1/ [R=301,L]

# 6. Custom 404 page
ErrorDocument 404 /404.html

# 7. Compression & browser caching
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
</IfModule>
